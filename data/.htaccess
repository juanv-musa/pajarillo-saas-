# Protección de Datos Sensibles y RGPD · Santuario de El Pajarillo
# Política segura por defecto: denegar acceso HTTP directo a cualquier JSON
# salvo los contenidos públicos explícitamente autorizados.

Options -Indexes

# 1. Bloquear acceso HTTP directo por defecto a archivos privados y confidenciales
<FilesMatch "(?i)\.(json|bak|log|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Permitir exclusivamente lectura de contenidos públicos consumidos por la WebApp cliente
<FilesMatch "(?i)^(paneles|locales|gallery|agenda|legal|kiosk_videos|site_config)\.json$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

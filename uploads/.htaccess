# Desactivar ejecución de scripts en el directorio de subidas (Seguridad Apache)
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Forzar tipo estático y desactivar handlers ejecutables
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh

# Denegar acceso si alguien lograra subir un script
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|cgi|sh|asp|aspx|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes
